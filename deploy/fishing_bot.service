[Unit]
Description=Arkhangelsk Fishing Bot & WebApp Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/fishing_bot
EnvironmentFile=-/root/fishing_bot/.env
Environment=NODE_ENV=production
Environment=PORT=3005
Environment=ENABLE_NODE_BOT_POLLING=false
ExecStart=/usr/bin/node dist/server.cjs
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

